# Secrets — never commit
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/

# IDE / 로컬 에이전트 설정
.vscode/
.idea/
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# 배치 임시 파일
temp_pdfs/

# 섹터 탭 런타임 스냅샷 (장 시작 전 직전 장 상태를 보여주기 위한 캐시)
# 매 조회마다 바뀌고, 커밋되면 오래된 값이 "직전 장"으로 표시될 수 있다.
data/sector/last_snapshot.json
# 매크로 배치가 "이번 실행에서 통째로 못 받아온 소스"를 적어 두는 쪽지.
# 같은 잡 안에서 --audit이 읽고 버린다 (batch_macro._FAIL_MARK 머리말).
data/macro/.fetch_fail.json

# DART corp_code 매핑 캐시 (7일마다 자동 재생성 · 175KB)
# 커밋해도 되지만 주기적으로 통째로 바뀌어 diff만 키운다.
data/dart/corp_map.json
data/dart/*.tmp

# 급등알림 배치 상태 — batch-state 브랜치에서 관리한다.
# main에 커밋되면 Streamlit Cloud가 5분마다 앱을 재시작한다.
data/surge_alert/

# 실적 배치 수집 재개 지점 — batch-state 브랜치에서 관리한다.
# main에 있으면 30분마다 타임스탬프가 바뀌며 앱이 재배포된다.
data/earnings/last_sync.txt
# 실적 데이터 본체는 batch-state 브랜치에 있다(2026-11-16, earnings_store 머리 주석).
# main에 두면 배치가 30분마다 커밋해 Streamlit Cloud가 하루 20번 앱을 재시작했다.
# ⚠️ 여기서 빼면 안 된다 — main에 이 파일이 생기는 순간 앱이 '로컬이 있다'로 보고
#    batch-state 대신 그 옛 파일을 영영 읽는다.
data/earnings/q_*.json
data/earnings/index.json
data/earnings/.cache/
